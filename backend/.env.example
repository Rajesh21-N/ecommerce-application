# ---- Database ----
DB_URL=jdbc:postgresql://localhost:5432/ecommerce
DB_USERNAME=postgres
DB_PASSWORD=your_password

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- JWT ----
# Generate your own: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_secret_key_min_256_bits
JWT_EXPIRATION_MS=86400000

# ---- Razorpay (payments) ----
# Leave RAZORPAY_ENABLED=false to use the built-in mock payment flow
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=your_key
RAZORPAY_KEY_SECRET=your_secret

# ---- Mail (SMTP) ----
# Leave MAIL_ENABLED=false to log emails instead of sending them
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@ecommerce.com

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
